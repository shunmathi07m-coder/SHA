{
  "manifest_version": 3,
  "name": "Which One Did I Send?",
  "version": "1.0.0",
  "description": "Know what you sent. Catch mistakes before you send. Version tracking, duplicate detection, and privacy leak shield.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    },
    "default_title": "Which One Did I Send?"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "shared/crypto.js",
        "shared/privacy-shield.js",
        "shared/fileguard.js",
        "shared/storage.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "dashboard/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
